# ==============================================================================
# CK Condo Drop Hub — Environment Variables Example Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit your real `.env` or `.env.local` to version control.
# ==============================================================================

# Application Configuration
NEXT_PUBLIC_APP_NAME="CK Condo Drop Hub"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase Client Configuration (Phase 2 - Spark Free Tier)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# Firebase Admin Service Account (Server-side Only)
# FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Session Security Secret (32+ chars random string)
# AUTH_SESSION_SECRET="your-secure-random-auth-session-secret"
